{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node tools/stamp-build.mjs",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(version.json|api/version)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/version",
      "destination": "/version.json"
    },
    {
      "source": "/",
      "destination": "/junior-results/index.html"
    },
    {
      "source": "/data/config.js",
      "destination": "/data/config.vercel.js"
    }
  ],
  "redirects": [
    {
      "source": "/criteria-simulator/:path*",
      "destination": "/junior-results/",
      "permanent": false
    },
    {
      "source": "/athlete-evaluation/:path*",
      "destination": "/junior-results/",
      "permanent": false
    },
    {
      "source": "/season-calendar/:path*",
      "destination": "/junior-results/",
      "permanent": false
    },
    {
      "source": "/membership-analytics/:path*",
      "destination": "/junior-results/",
      "permanent": false
    },
    {
      "source": "/schedule-builder/:path*",
      "destination": "/junior-results/",
      "permanent": false
    },
    {
      "source": "/hp-analytics/:path*",
      "destination": "/junior-results/",
      "permanent": false
    }
  ]
}